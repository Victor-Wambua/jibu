# Copy to .env and edit. Nothing here is required to try Jibu locally.
# Load it with:  set -a; source .env; set +a

# --- knowledge base
JIBU_KB_DIR=kb
JIBU_DEFAULT_KB=umoja-sacco
# Override the per-knowledge-base confidence threshold (0-1). Leave empty to use the KB file's value.
JIBU_THRESHOLD=

# --- API
JIBU_RATE_LIMIT=30/60            # requests / seconds, per client IP, on /chat and /feedback
JIBU_TRUST_PROXY=false           # true only behind a proxy you control (uses the last X-Forwarded-For entry)
JIBU_CORS_ORIGINS=               # comma separated origins allowed to call the API from a browser
JIBU_ADMIN_TOKEN=                # enables /admin/*; use a long random value. Empty = admin disabled
JIBU_SESSION_TTL=600             # seconds a follow-up context is remembered

# --- privacy: by default NO message text is stored anywhere
JIBU_STORE_UNANSWERED_TEXT=false # true = keep the (redacted) text of handed-off questions
JIBU_UNANSWERED_FILE=            # e.g. data/unanswered.jsonl ; empty = in-memory only
JIBU_FEEDBACK_FILE=              # e.g. data/feedback.jsonl ; stores entry id + thumbs only
JIBU_HASH_SECRET=                # stable secret for pseudonymising WhatsApp senders (random per start if empty)

# --- WhatsApp Cloud API (NOT verified against the live Meta API)
JIBU_WA_VERIFY_TOKEN=            # the token you type into Meta's webhook setup
JIBU_WA_APP_SECRET=              # app secret used to check X-Hub-Signature-256; empty = webhook disabled
JIBU_WA_KB=umoja-sacco           # which knowledge base answers WhatsApp messages
JIBU_WA_SEND=false               # false = log replies only. true = call the Cloud API (needs the two below)
JIBU_WA_ACCESS_TOKEN=
JIBU_WA_PHONE_NUMBER_ID=
